# Frontend environment (copy to .env).
# Variables starting with VITE_ are built into the JavaScript and visible
# to anyone in the browser — NEVER put secrets here.

# Base path of the Rails API. Relative, so it works through the Vite proxy
# in development and through nginx in Docker.
VITE_API_URL=/api

# Dev only: where `npm run dev` forwards /api and /cable (not sent to the browser).
API_PROXY_TARGET=http://localhost:3000

POSTGRES_DB=ft_transcendence
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

BACKEND_PORT=3001
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001
